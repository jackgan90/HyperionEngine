{
  "type": "hyperion.application-settings",
  "schema_version": 1,
  "properties": {
    "reversed_z": true,
    "title": "Hyperion | glTF Model Viewer",
    "width": 1440,
    "height": 900,
    "workers": 4,
    "rhi_threads": 2,
    "rhi_backend": "d3d12",
    "model_source": "out/content/Models/Showcase.hasset",
    "plugins": ["model-viewer", "debug-ui"],
    "show_gui": true,
    "vsync": true,
    "clear_red": 0.025,
    "clear_green": 0.035,
    "clear_blue": 0.065
  }
}
