# Downloaded dependencies, build outputs, captures, logs, caches and scratch work.
/out/
/build/
/build-*/
/cmake-build-*/

# CMake-generated files (CMakeLists.txt and shared CMakePresets.json are source).
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
DartConfiguration.tcl
Testing/
Makefile
build.ninja
rules.ninja
.ninja_deps
.ninja_log
compile_commands.json
/CMakeUserPresets.json

# Visual Studio solutions/projects are generated by GenerateSolution.cmd.
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
*.ipch
.vs/
.idea/
/.vscode/

# Compiler/linker products. Do not blanket-ignore source assets such as .bin/.png.
*.obj
*.o
*.pch
*.pdb
*.idb
*.ilk
*.exp
*.tlog
*.lastbuildstate
*.lib
*.a
*.dll
*.exe
*.so
*.dylib

# Python environments and caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
/.venv/
/venv/

# Project skills are shared; other Codex state is local by default.
/.codex/*
!/.codex/skills/

# Local environment overrides; example/template files may be shared.
.env
.env.*
!.env.example
!.env.template

# Temporary files and operating-system metadata.
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
*.dmp
.DS_Store
Thumbs.db
Desktop.ini

# Outputs from running test executables directly from the repository root.
/asset-test/
/shader-test/
/viewer-acceptance/
/test-settings.json
/test-invalid.json
/test-defaults.json
/gui-settings.json
/imgui.ini
